{% extends '_mon_cartable.html.twig' %}

{% import '_partials/_macros.html.twig' as m %}

{% set active_nav = 'dashboard' %}

{% block title %}Mon cartable · La Récrée Tech{% endblock %}

{% block contenu %}

    <section class="cb-tete">
        <p class="cb-num">Mon cartable</p>
        <h1 class="cb-titre">Bon <em>retour</em>, {{ app.user.firstName }}.</h1>
        {% if snapshot.enrollmentSnapshots|length > 0 %}
            <p class="cb-note">ta leçon t'attend là où tu l'as laissée</p>
        {% endif %}
    </section>

    {# La leçon commencée à reprendre, sinon la prochaine leçon du programme #}
    {% set reprise = null %}
    {% if snapshot.currentProgress %}
        {% set reprise = { lesson: snapshot.currentProgress.lesson, progress: snapshot.currentProgress } %}
    {% elseif snapshot.nextLesson %}
        {% set reprise = { lesson: snapshot.nextLesson, progress: null } %}
    {% endif %}

    {% if reprise %}
        {% set lesson = reprise.lesson %}
        {% set module = lesson.module %}
        {% set formation = module.formation %}
        {% set url = path('app_lesson_show', { slug: formation.slug, moduleSlug: module.slug, lessonSlug: lesson.slug }) %}
        <section class="cb-reprendre" aria-labelledby="titre-reprendre">
            <div class="cb-video">
                {% if lesson.hasSelfHostedVideo %}
                    <video preload="metadata" controls playsinline
                           src="{{ path('app_lesson_video', { slug: formation.slug, moduleSlug: module.slug, lessonSlug: lesson.slug }) }}#t=0.1"></video>
                {% else %}
                    <a href="{{ url }}" class="cb-lecture" aria-label="Ouvrir la leçon">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
                    </a>
                {% endif %}
                <span class="cb-duree">{{ m.duree(lesson.durationSeconds) }}</span>
            </div>

            <div class="cb-reprendre-texte">
                <p class="cb-surtitre">{{ reprise.progress ? 'Reprendre' : 'Ta prochaine leçon' }}</p>
                <h2 id="titre-reprendre">{{ lesson.title }}</h2>
                <p class="cb-ou">{{ formation.title }} · Cours {{ module.displayOrder }} · Leçon {{ lesson.displayOrder }}</p>

                {% if reprise.progress %}
                    {% set vu = reprise.progress.watchedSeconds %}
                    {% set reste = lesson.durationSeconds - vu %}
                    <div class="cb-progres" role="progressbar" aria-label="Avancée dans la leçon" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ reprise.progress.percentWatched }}">
                        <span style="width: {{ reprise.progress.percentWatched }}%"></span>
                    </div>
                    <p class="cb-meta"><strong>{{ reprise.progress.percentWatched }} %</strong> vus{% if reste > 0 %} · encore {{ m.duree(reste) }}{% endif %} · le {{ reprise.progress.lastWatchedAt|date('d/m/Y') }}</p>
                    <a href="{{ url }}" class="ct-bouton cb-bouton">Reprendre la leçon</a>
                {% else %}
                    <a href="{{ url }}" class="ct-bouton cb-bouton">Commencer la leçon</a>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {% if snapshot.enrollmentSnapshots|length > 0 %}
        <section class="cb-section" aria-labelledby="titre-edt">
            <div class="cb-section-tete">
                <h2 class="cb-h2" id="titre-edt">Ton <em>emploi du temps</em></h2>
                {% if snapshot.totalWatchedHours != '0 min' %}<p class="cb-discret">Vidéo regardée jusqu'ici : {{ snapshot.totalWatchedHours }}</p>{% endif %}
            </div>

            {% for es in snapshot.enrollmentSnapshots %}
                {% set pm = es.progressMap %}
                {% set formation = es.enrollment.formation %}
                <article class="cb-edt">
                    <header class="cb-edt-tete">
                        <h3>{{ formation.title }}{% if es.enrollment.isVipGranted %} <span class="cb-badge">VIP</span>{% endif %}</h3>
                        <p><strong>{{ pm.overallPercent }} %</strong> · {{ pm.doneModulesCount }} cours terminé{{ pm.doneModulesCount > 1 ? 's' }} sur {{ pm.totalModulesCount }}</p>
                    </header>

                    <ol class="cb-marelle">
                        {% for item in pm.items %}
                            {% set fait = item.state in ['done', 'finale-done'] %}
                            <li class="cb-case{{ fait ? ' est-fait' }}{{ item.state == 'current' ? ' est-en-cours' }}">
                                <span class="cb-case-num">
                                    {% if fait %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visuellement-cache">Terminé : </span>{% endif %}
                                    {% if not fait %}{{ item.index }}{% endif %}
                                </span>
                                <span class="cb-case-titre">{{ item.title }}</span>
                                {% if item.state == 'current' %}<span class="cb-case-pct">en cours</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ol>

                    <footer class="cb-edt-pied">
                        {% if pm.lastCompletedTitle %}<span>Dernier cours terminé : <strong>{{ pm.lastCompletedTitle }}</strong></span>{% endif %}
                        <a href="{{ path('app_formation_show', { slug: formation.slug }) }}" class="cb-lien">Voir le programme →</a>
                    </footer>
                </article>
            {% endfor %}
        </section>
    {% else %}
        <section class="cb-vide">
            <h2 class="cb-h2">Ton cartable est <em>vide</em> pour l'instant.</h2>
            <p>Choisis ta formation : ses cours et ses leçons arriveront ici.</p>
            <a href="{{ path('app_catalogue') }}" class="ct-bouton cb-bouton">Voir les formations</a>
        </section>
    {% endif %}

{% endblock %}
