{% extends '_mon_cartable.html.twig' %}

{% set active_nav = 'community' %}

{% block title %}La classe · La Récrée Tech{% endblock %}

{% block contenu %}

    <section class="cb-tete">
        <p class="cb-num">La classe</p>
        <h1 class="cb-titre">La classe, sur <em>Discord</em>.</h1>
    </section>

    <section class="cb-classe" aria-label="Rejoindre la classe">
        <div>
            <p class="cb-surtitre">ta place est gardée</p>
            <p class="cb-classe-texte">C'est là que tu poses tes questions entre deux leçons, que tu montres tes devoirs rendus et que tu donnes un coup de main aux autres.</p>
        </div>
        <div class="cb-classe-action">
            <a href="{{ discordInvite }}" class="ct-bouton cb-bouton" target="_blank" rel="noopener">Rejoindre la classe sur Discord</a>
            <p>Inclus avec ta formation, à vie.</p>
        </div>
    </section>

    <section class="cb-section" aria-labelledby="titre-pas">
        <h2 class="cb-h2" id="titre-pas">Trois pas pour <em>entrer</em></h2>
        <ol class="cb-marelle cb-pas">
            {% for step in steps %}
                <li class="cb-case">
                    <span class="cb-case-num">{{ loop.index }}</span>
                    <strong class="cb-h3">{{ step.title }}</strong>
                    <span class="cb-case-titre">{{ step.desc }}</span>
                </li>
            {% endfor %}
        </ol>
    </section>

    <section class="cb-section" aria-labelledby="titre-salons">
        <h2 class="cb-h2" id="titre-salons">Les <em>salons</em></h2>
        <ul class="cb-salons">
            {% for channel in channels %}
                <li>
                    <strong>{{ channel.name }}</strong>
                    <span>{{ channel.desc }}</span>
                </li>
            {% endfor %}
        </ul>
    </section>

    <section class="cb-section" aria-labelledby="titre-reglement">
        <h2 class="cb-h2" id="titre-reglement">Le <em>règlement</em> de la classe</h2>
        <ol class="cb-reglement">
            {% for rule in rules %}
                <li>{{ rule }}</li>
            {% endfor %}
        </ol>
    </section>

{% endblock %}
