{% extends 'emails/_base.html.twig' %}

{% block title %}Nouvelle inscription{% endblock %}
{% block surtitre %}{{ alreadyEnrolled ? 'Nouveau paiement' : 'Nouvelle inscription' }}{% endblock %}
{% block titre %}{{ alreadyEnrolled ? 'Un nouveau paiement est arrivé.' : "Quelqu'un vient de s'inscrire." }}{% endblock %}

{% block contenu %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; line-height: 1.6;">
        <tr><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #3f4a42; width: 130px;">Formation</td><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #1f3025;"><strong>{{ formation.title }}</strong></td></tr>
        <tr><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #3f4a42; width: 130px;">Élève</td><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #1f3025;">{{ user.firstName }} &lt;{{ user.email }}&gt;</td></tr>
        <tr><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #3f4a42; width: 130px;">Montant</td><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #1f3025;"><strong>{{ (payment.amountCents / 100)|number_format(0, ',', ' ') }} {{ payment.currency }}</strong></td></tr>
        <tr><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #3f4a42; width: 130px;">Date</td><td style="padding: 10px 0; border-bottom: 1px solid #e3e0d8; color: #1f3025;">{{ payment.createdAt|date('d/m/Y · H:i') }}</td></tr>
        <tr><td style="padding: 10px 0; color: #3f4a42;">Réf. Stripe</td><td style="padding: 10px 0; font-family: 'Courier New', monospace; font-size: 12px; word-break: break-all; color: #1f3025;">{{ payment.stripePaymentIntentId ?? payment.stripeSessionId }}</td></tr>
    </table>
    {% if alreadyEnrolled %}
        <p style="margin: 20px 0 0; font-size: 13px; line-height: 1.6; color: #3f4a42;">Cette personne était déjà inscrite à cette formation (rachat ou mensualité).</p>
    {% endif %}
{% endblock %}

{% block pied %}Notification automatique de l'app · La Récrée Tech{% endblock %}
