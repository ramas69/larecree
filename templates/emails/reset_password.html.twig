{% extends 'emails/_base.html.twig' %}

{% block title %}Ton nouveau mot de passe{% endblock %}
{% block surtitre %}Mot de passe oublié{% endblock %}
{% block titre %}Salut{{ user.firstName ? ' ' ~ user.firstName }},{% endblock %}

{% block contenu %}
    <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #3f4a42;">Tu as demandé un nouveau mot de passe pour ton cartable sur <strong style="color: #1f3025;">app.larecreetech.com</strong>. Le bouton ci-dessous est valable {{ ttlMin }} minutes.</p>
    <p style="margin: 28px 0; text-align: center;"><a href="{{ resetUrl }}" style="display: inline-block; background: #e3ab1f; color: #1f3025; padding: 14px 28px; border-radius: 10px; text-decoration: none; font-weight: bold; font-size: 16px;">Choisir un nouveau mot de passe</a></p>
    <p style="margin: 0 0 8px; font-size: 13px; line-height: 1.6; color: #3f4a42;">Si le bouton ne marche pas, copie ce lien dans ton navigateur :</p>
    <p style="margin: 0 0 20px; padding: 12px; font-family: 'Courier New', monospace; font-size: 12px; word-break: break-all; background: #f7f6f3; border: 1px solid #e3e0d8; border-radius: 8px; color: #1f3025;">{{ resetUrl }}</p>
    <p style="margin: 0; padding-top: 20px; border-top: 1px solid #e3e0d8; font-size: 13px; line-height: 1.6; color: #3f4a42;">Tu n'as rien demandé ? Ignore cet e-mail : ton mot de passe ne change pas.</p>
{% endblock %}
