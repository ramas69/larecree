{% extends '_mon_cartable.html.twig' %}

{% set active_nav = 'account' %}

{% block title %}Mon compte · La Récrée Tech{% endblock %}

{% block contenu %}

    <section class="cb-tete">
        <p class="cb-num">Mon compte</p>
        <h1 class="cb-titre">Ton <em>compte</em>.</h1>
    </section>

    {% for msg in app.flashes('success') %}
        <div class="ct-succes" role="status">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="ct-alerte" role="alert">{{ msg }}</div>
    {% endfor %}

    <div class="cb-compte-grille">
        <section class="cb-fiche" aria-labelledby="titre-profil">
            <h2 class="cb-h3" id="titre-profil">Ton profil</h2>
            <form method="post" action="{{ path('app_account_profile') }}" data-turbo="false">
                <div class="ct-champ">
                    <label for="first_name">Prénom</label>
                    <input type="text" id="first_name" name="first_name" value="{{ user.firstName }}" required autocomplete="given-name">
                </div>
                <div class="ct-champ">
                    <label for="last_name">Nom</label>
                    <input type="text" id="last_name" name="last_name" value="{{ user.lastName }}" autocomplete="family-name">
                </div>
                <div class="ct-champ">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email" value="{{ user.email }}" required autocomplete="email">
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('account_profile') }}">
                <button type="submit" class="ct-bouton cb-bouton">Enregistrer</button>
            </form>
        </section>

        <section class="cb-fiche" aria-labelledby="titre-mdp">
            <h2 class="cb-h3" id="titre-mdp">Ton mot de passe</h2>
            <form method="post" action="{{ path('app_account_password') }}" data-turbo="false">
                <div class="ct-champ">
                    <label for="current_password">Mot de passe actuel</label>
                    <input type="password" id="current_password" name="current_password" required autocomplete="current-password">
                </div>
                <div class="ct-champ">
                    <label for="new_password">Nouveau mot de passe <span class="cb-aide">8 caractères minimum</span></label>
                    <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password">
                </div>
                <div class="ct-champ">
                    <label for="new_password_confirm">Encore une fois, pour vérifier</label>
                    <input type="password" id="new_password_confirm" name="new_password_confirm" required minlength="8" autocomplete="new-password">
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('account_password') }}">
                <button type="submit" class="ct-bouton cb-bouton">Changer le mot de passe</button>
            </form>
        </section>
    </div>

    <section class="cb-section" aria-labelledby="titre-mes-formations">
        <h2 class="cb-h2" id="titre-mes-formations">Tes <em>formations</em></h2>
        {% if enrollments|length > 0 %}
            <ul class="cb-mes-formations">
                {% for e in enrollments %}
                    {% set f = e.formation %}
                    <li>
                        <a href="{{ path('app_formation_show', { slug: f.slug }) }}">
                            <span>
                                <strong>{{ f.title }}</strong>{% if e.isVipGranted %} <span class="cb-badge">VIP</span>{% endif %}
                                {% if f.subtitle %}<em>{{ f.subtitle }}</em>{% endif %}
                            </span>
                            <span class="cb-cours-action">Ouvrir →</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucune formation dans ton cartable pour l'instant. <a href="{{ path('app_catalogue') }}" class="cb-lien">Voir les formations →</a></p>
        {% endif %}
    </section>

{% endblock %}
