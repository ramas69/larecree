{% extends 'security/_cartable.html.twig' %}

{% block title %}Merci pour ton inscription · La Récrée Tech{% endblock %}
{% block tableau %}Bienvenue dans la <em>classe</em>.{% endblock %}
{% block note %}ton cartable est prêt{% endblock %}

{% block carte %}
    <p class="ct-eyebrow">Paiement confirmé</p>
    <h1 class="ct-titre">C'est <em>validé</em>.</h1>
    {% if formation %}
        <p class="ct-sous">Ton inscription à <strong>{{ formation.title }}</strong> est validée.</p>
    {% else %}
        <p class="ct-sous">Ton paiement a bien été reçu.</p>
    {% endif %}
    <p class="ct-sous">Dans quelques minutes, un e-mail t'apporte un lien pour <strong>choisir ton mot de passe</strong> et ouvrir ta formation. Regarde aussi dans les indésirables.</p>
    <a href="https://larecreetech.com" class="ct-bouton">Retour au site</a>
{% endblock %}
