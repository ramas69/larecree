<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <meta name="theme-color" content="#1F3025">
    <title>{% block title %}Erreur{% endblock %} · La Récrée Tech</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Lexend:wght@300;400;500&family=Caveat:wght@600&display=swap" rel="stylesheet">
    {# Styles dans la page : une page d'erreur ne doit dépendre de rien (design « école » du site). #}
    <style>
        :root { --vert: #1f3025; --creme: #f3f1ea; --blanc: #fff; --moutarde: #e3ab1f; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 96px 24px 48px; font-family: 'Lexend', system-ui, sans-serif; font-weight: 300; color: var(--creme); background-color: var(--vert);
            background-image: linear-gradient(rgba(243,241,234,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(243,241,234,.06) 1px, transparent 1px); background-size: 30px 30px; }
        a { color: inherit; }
        :focus-visible { outline: 3px solid var(--moutarde); outline-offset: 3px; border-radius: 4px; }
        .marque { position: absolute; top: 22px; left: 24px; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: 'Newsreader', Georgia, serif; font-size: 22px; color: var(--blanc); }
        .marque svg { width: 32px; height: 32px; }
        .marque em { font-style: italic; }
        .carte { max-width: 560px; text-align: center; }
        .num { display: inline-flex; align-items: center; gap: 14px; font-size: 13px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; }
        .num::after { content: ""; width: 48px; height: 2px; border-radius: 1px; background: var(--moutarde); }
        .code { margin: 10px 0 0; font-family: 'Newsreader', Georgia, serif; font-style: italic; font-size: clamp(88px, 20vw, 150px); line-height: 1; color: var(--blanc); }
        .code span { background: linear-gradient(transparent 76%, var(--moutarde) 76%, var(--moutarde) 88%, transparent 88%); padding: 0 .06em; }
        .note { display: inline-block; margin: 10px 0 18px; font-family: 'Caveat', cursive; font-weight: 600; font-size: 30px; transform: rotate(-2deg); }
        h1 { font-family: 'Newsreader', Georgia, serif; font-style: italic; font-weight: 400; font-size: clamp(26px, 5vw, 36px); line-height: 1.2; color: var(--blanc); text-wrap: balance; }
        h1 em { background: linear-gradient(transparent 60%, var(--moutarde) 60%, var(--moutarde) 92%, transparent 92%); }
        .texte { margin: 14px auto 28px; max-width: 46ch; font-size: 17px; line-height: 1.6; }
        .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
        .bouton { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 12px 24px; border-radius: 10px; font-size: 16px; font-weight: 500; text-decoration: none; }
        .bouton.plein { background: var(--moutarde); color: var(--vert); }
        .bouton.plein:hover { filter: brightness(.94); }
        .bouton.trait { border: 1.5px solid rgba(243,241,234,.4); color: var(--creme); }
        .bouton.trait:hover { border-color: var(--creme); }
    </style>
</head>
<body>
    <a href="https://larecreetech.com" class="marque" aria-label="La Récrée Tech, le site">
        {% include '_partials/_logo.html.twig' %}
        <span>la <em>récrée</em> tech.</span>
    </a>
    <main class="carte">
        <p class="num">{% block eyebrow %}Erreur{% endblock %}</p>
        <p class="code"><span>{% block code %}Oups{% endblock %}</span></p>
        <p class="note">{% block caveat %}c'est pas toi, c'est nous{% endblock %}</p>
        <h1>{% block heading %}Une erreur est survenue.{% endblock %}</h1>
        <p class="texte">{% block message %}{% endblock %}</p>
        <div class="actions">
            {% block actions %}
                <a href="{{ path('app_dashboard') }}" class="bouton plein">Mon cartable</a>
                <a href="https://larecreetech.com" class="bouton trait">Retour au site</a>
            {% endblock %}
        </div>
    </main>
</body>
</html>
