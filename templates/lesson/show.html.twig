{% extends '_mon_cartable.html.twig' %}

{% import '_partials/_macros.html.twig' as m %}

{% set active_nav = 'dashboard' %}

{% block title %}{{ lesson.title }} · {{ formation.title }}{% endblock %}

{% block contenu %}
{% set isDone = progress and progress.isCompleted %}
{% set pct = progress ? progress.percentWatched : 0 %}

<nav class="cb-fil" aria-label="Fil d'Ariane">
    <a href="{{ path('app_dashboard') }}">Mon cartable</a>
    <span aria-hidden="true">›</span>
    <a href="{{ path('app_formation_show', { slug: formation.slug }) }}">{{ formation.title }}</a>
    <span aria-hidden="true">›</span>
    <span>Étape {{ module.displayOrder }} · {{ module.nom }}</span>
</nav>

<header class="cb-lecon-tete">
    <p class="cb-num">Étape {{ module.displayOrder }} · Leçon {{ lesson.displayOrder }} · {{ m.duree(lesson.durationSeconds) }}</p>
    <h1 class="cb-titre cb-titre-lecon">{{ lesson.title }}</h1>
</header>

{% for message in app.flashes('success') %}
    <div class="ct-succes" role="status">{{ message }}</div>
{% endfor %}

<div class="cb-lecon">
    <div class="cb-lecon-principal">

        <div class="cb-ecran">
            {% if lesson.hasSelfHostedVideo %}
                <video data-lp-video controls controlsList="nodownload" preload="metadata" playsinline
                       title="{{ lesson.title }}"
                       src="{{ path('app_lesson_video', { slug: formation.slug, moduleSlug: module.slug, lessonSlug: lesson.slug }) }}">
                    Ton navigateur ne peut pas lire cette vidéo.
                </video>
                <div class="cb-chargement" data-lp-loader>
                    <span class="cb-roue" aria-hidden="true"></span>
                    <span>Chargement de la vidéo…</span>
                </div>
            {% else %}
                <p class="cb-sans-video">la vidéo arrive bientôt</p>
            {% endif %}
        </div>

        <div class="cb-etat">
            {% if isDone %}
                <p class="cb-etat-texte"><span class="cb-pastille est-fait">Terminée</span> le {{ progress.completedAt|date('d/m/Y') }}</p>
            {% elseif pct > 0 %}
                <p class="cb-etat-texte"><span class="cb-pastille est-en-cours">En cours</span> {{ pct }} % vus · le {{ progress.lastWatchedAt|date('d/m/Y') }}</p>
            {% else %}
                <p class="cb-etat-texte"><span class="cb-pastille">À voir</span> {{ m.duree(lesson.durationSeconds) }}</p>
            {% endif %}

            {% if not isDone %}
                <form method="post" action="{{ path('app_lesson_complete', { slug: formation.slug, moduleSlug: module.slug, lessonSlug: lesson.slug }) }}" class="cb-terminer">
                    <input type="hidden" name="_token" value="{{ csrf_token('lesson_complete_' ~ lesson.slug) }}">
                    <button type="submit" class="ct-bouton cb-bouton">J'ai terminé cette leçon</button>
                </form>
            {% endif %}
        </div>

        {% if lesson.description %}
            <section class="cb-feuille" aria-labelledby="titre-programme">
                <h2 class="cb-h3" id="titre-programme">Au programme de cette leçon</h2>
                <div class="cb-feuille-texte">{{ '<' in lesson.description ? lesson.description|raw : lesson.description|nl2br }}</div>
            </section>
        {% endif %}

        <nav class="cb-suite" aria-label="Leçon précédente et suivante">
            {% if prevLesson %}
                <a href="{{ path('app_lesson_show', { slug: formation.slug, moduleSlug: prevLesson.module.slug, lessonSlug: prevLesson.slug }) }}" class="cb-suite-lien">
                    <small>← Leçon précédente</small>
                    <strong>{{ prevLesson.title }}</strong>
                </a>
            {% else %}
                <span class="cb-suite-lien est-inactif"><small>← Leçon précédente</small><strong>Début de la formation</strong></span>
            {% endif %}

            {% if nextLesson %}
                <a href="{{ path('app_lesson_show', { slug: formation.slug, moduleSlug: nextLesson.module.slug, lessonSlug: nextLesson.slug }) }}" class="cb-suite-lien cb-suite-apres">
                    <small>Leçon suivante →</small>
                    <strong>{{ nextLesson.title }}</strong>
                </a>
            {% else %}
                <span class="cb-suite-lien cb-suite-apres est-inactif"><small>Leçon suivante →</small><strong>Fin de la formation</strong></span>
            {% endif %}
        </nav>
    </div>

    <aside class="cb-lecon-cote">
        <section class="cb-plan" aria-labelledby="titre-plan">
            <p class="cb-plan-sur">Étape {{ module.displayOrder }}</p>
            <h2 class="cb-h3" id="titre-plan">{{ module.nom }}</h2>
            <div class="cb-progres cb-progres-clair" role="progressbar" aria-label="Avancée dans l'étape" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ moduleStats.percent }}">
                <span style="width: {{ moduleStats.percent }}%"></span>
            </div>
            <p class="cb-plan-compte">{{ moduleStats.doneCount }} leçon{{ moduleStats.doneCount > 1 ? 's' }} terminée{{ moduleStats.doneCount > 1 ? 's' }} sur {{ moduleStats.totalCount }}</p>

            <ol class="cb-plan-liste">
                {% for l in allLessonsInModule %}
                    {% set ici = l == lesson %}
                    {% set lp = progressByLessonId[l.id] ?? null %}
                    {% set lFait = lp and lp.isCompleted %}
                    {% set lCommence = lp and lp.percentWatched > 0 and not lFait %}
                    <li class="cb-plan-item{{ ici ? ' est-ici' }}{{ lFait ? ' est-fait' }}">
                        <a href="{{ path('app_lesson_show', { slug: formation.slug, moduleSlug: module.slug, lessonSlug: l.slug }) }}" {% if ici %}aria-current="page"{% endif %}>
                            <span class="cb-plan-num">
                                {% if lFait %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visuellement-cache">Terminée : </span>{% else %}{{ loop.index }}{% endif %}
                            </span>
                            <span class="cb-plan-texte">
                                <strong>{{ l.title }}</strong>
                                <em>{{ m.duree(l.durationSeconds) }}{% if lCommence %} · {{ lp.percentWatched }} % vus{% endif %}</em>
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ol>
        </section>

        {% if lesson.resources|length > 0 %}
            <section class="cb-ressources" aria-labelledby="titre-ressources">
                <h2 class="cb-h3" id="titre-ressources">Dans ton cartable</h2>
                <ul>
                    {% for r in lesson.resources %}
                        {% set isFile = r.type.value == 'file' %}
                        {% set href = isFile ? r.filePath : r.url %}
                        {% if href %}
                            <li>
                                <a href="{{ href }}" {{ isFile ? '' : 'target="_blank" rel="noopener"' }}>
                                    <span class="cb-ressource-icone" aria-hidden="true">
                                        {% if isFile %}
                                            <svg viewBox="0 0 24 24"><path d="M7 3h7l5 5v13H7z M14 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                                        {% else %}
                                            <svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                                        {% endif %}
                                    </span>
                                    <span class="cb-ressource-texte">
                                        <strong>{{ r.title }}</strong>
                                        <em>{{ isFile ? 'PDF à télécharger' : 'Lien, dans un nouvel onglet' }}</em>
                                    </span>
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </aside>
</div>

<script>
(function () {
    var video = document.querySelector('[data-lp-video]');
    if (!video) { return; }

    // Indicateur de chargement
    var loader = document.querySelector('[data-lp-loader]');
    if (loader) {
        var hide = function () { loader.style.display = 'none'; };
        var show = function () { loader.style.display = 'flex'; };
        if (video.readyState >= 3) { hide(); }
        video.addEventListener('canplay', hide);
        video.addEventListener('playing', hide);
        video.addEventListener('waiting', show);
        video.addEventListener('error', function () {
            loader.querySelector('span:last-child').textContent = 'Vidéo indisponible. Réessaie ou recharge la page.';
        });
    }

    // Vidéo regardée jusqu'au bout → marque terminé + enchaîne la leçon suivante
    var completeForm = document.querySelector('form.cb-terminer');
    if (completeForm) {
        var sent = false;
        video.addEventListener('ended', function () {
            if (sent) { return; }
            sent = true;
            completeForm.submit();
        });
    }
})();
</script>
{% endblock %}
