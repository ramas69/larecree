{% extends '_mon_cartable.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% set active_nav = 'catalogue' %}

{% block title %}Les formations · La Récrée Tech{% endblock %}

{% block contenu %}

    <section class="cb-tete">
        <p class="cb-num">Les formations</p>
        <h1 class="cb-titre">Choisis ta prochaine <em>formation</em>.</h1>
        <p class="cb-note">une formation, un cahier</p>
    </section>

    <section class="cb-cahiers" aria-label="Les formations">
        {% for card in cards %}
            {% set f = card.formation %}
            {% set bientot = f.isComingSoon %}
            <article class="cb-cahier{{ bientot ? ' est-bientot' }}{{ card.enrolled ? ' est-inscrit' }}">
                <div class="cb-cahier-couv">
                    <span class="cb-cahier-num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                    {% if bientot %}
                        <span class="cb-badge cb-badge-clair">Bientôt</span>
                    {% elseif card.enrolled %}
                        <span class="cb-badge">{{ card.vipGranted ? 'VIP' : 'Dans ton cartable' }}</span>
                    {% endif %}
                    <div class="cb-etiquette">
                        <span>Formation</span>
                        <h2>
                            {% if bientot %}{{ f.title }}{% else %}<a href="{{ path('app_formation_show', { slug: f.slug }) }}">{{ f.title }}</a>{% endif %}
                        </h2>
                    </div>
                </div>

                <div class="cb-cahier-corps">
                    {% if f.subtitle %}<p class="cb-cahier-sous">{{ f.subtitle }}</p>{% endif %}
                    {% if card.modulesCount > 0 %}<p class="cb-discret">{{ card.modulesCount }} étapes · {{ card.lessonsCount }} leçons · {{ card.totalDurationFormatted }}</p>{% endif %}

                    {% if bientot %}
                        <p class="cb-cahier-bientot">elle arrive bientôt</p>
                    {% elseif card.enrolled %}
                        <div class="cb-progres cb-progres-clair" role="progressbar" aria-label="Avancée dans {{ f.title }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ card.progressPercent }}">
                            <span style="width: {{ card.progressPercent }}%"></span>
                        </div>
                        <p class="cb-discret"><strong>{{ card.progressPercent }} %</strong> · {{ card.completedLessonsCount }} leçon{{ card.completedLessonsCount > 1 ? 's' }} terminée{{ card.completedLessonsCount > 1 ? 's' }} sur {{ card.lessonsCount }}</p>
                        <a href="{{ path('app_formation_show', { slug: f.slug }) }}" class="ct-bouton">Reprendre la formation</a>
                    {% else %}
                        <p class="cb-cahier-prix">{{ m.prix(f) }}</p>
                        <a href="{{ path('app_formation_show', { slug: f.slug }) }}" class="ct-bouton cb-bouton-trait">Voir le programme</a>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <p>Aucune formation publiée pour l'instant.</p>
        {% endfor %}
    </section>

{% endblock %}
