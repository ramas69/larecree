{% extends '_mon_cartable.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% set active_nav = enrollment ? 'dashboard' : 'catalogue' %}

{% block title %}{{ formation.title }} · La Récrée Tech{% endblock %}

{% block contenu %}
{% set nbLecons = 0 %}
{% set secondes = 0 %}
{% set nbFaites = 0 %}
{% for module in formation.modules %}
    {% for lesson in module.lessons %}
        {% set nbLecons = nbLecons + 1 %}
        {% set secondes = secondes + lesson.durationSeconds %}
        {% if completedLessonIds[lesson.id] ?? false %}{% set nbFaites = nbFaites + 1 %}{% endif %}
    {% endfor %}
{% endfor %}

<nav class="cb-fil" aria-label="Fil d'Ariane">
    {% if enrollment %}<a href="{{ path('app_dashboard') }}">Mon cartable</a>{% else %}<a href="{{ path('app_catalogue') }}">Les formations</a>{% endif %}
    <span aria-hidden="true">›</span>
    <span>{{ formation.title }}</span>
</nav>

<section class="cb-formation-tete">
    <div class="cb-formation-texte">
        <p class="cb-num">La formation</p>
        <h1 class="cb-titre">{{ formation.title }}</h1>
        {% if formation.subtitle %}<p class="cb-note">{{ formation.subtitle }}</p>{% endif %}
        {% if formation.description %}
            <div class="cb-formation-desc">{{ '<' in formation.description ? formation.description|raw : formation.description|nl2br }}</div>
        {% endif %}
    </div>

    <aside class="cb-formation-carte">
        <p class="cb-discret">{{ formation.modules|length }} cours · {{ nbLecons }} leçons · {{ secondes >= 3600 ? (secondes // 3600) ~ ' h ' ~ ('%02d'|format(secondes % 3600 // 60)) : (secondes // 60) ~ ' min' }}</p>
        {% if enrollment %}
            <p class="cb-formation-statut"><span class="cb-badge">{{ enrollment.isVipGranted ? 'VIP' : 'Dans ton cartable' }}</span></p>
            {% set pct = nbLecons > 0 ? (nbFaites * 100 / nbLecons)|round : 0 %}
            <div class="cb-progres cb-progres-clair" role="progressbar" aria-label="Avancée dans la formation" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
                <span style="width: {{ pct }}%"></span>
            </div>
            <p class="cb-discret"><strong>{{ pct }} %</strong> · {{ nbFaites }} leçon{{ nbFaites > 1 ? 's' }} terminée{{ nbFaites > 1 ? 's' }} sur {{ nbLecons }}</p>
        {% else %}
            <p class="cb-cahier-prix">{{ m.prix(formation) }}</p>
            <a href="{{ path('app_checkout_start', { slug: formation.slug }) }}" class="ct-bouton">Je prends ma place</a>
            <a href="{{ path('app_checkout_start', { slug: formation.slug, plan: '3x' }) }}" class="cb-lien cb-lien-centre">ou en 3 fois sans frais</a>
        {% endif %}
    </aside>
</section>

<section class="cb-section" aria-labelledby="titre-programme">
    <h2 class="cb-h2" id="titre-programme">Le <em>programme</em></h2>

    {% for module in formation.modules %}
        {% set faites = 0 %}
        {% for lesson in module.lessons %}{% if completedLessonIds[lesson.id] ?? false %}{% set faites = faites + 1 %}{% endif %}{% endfor %}
        {% set coursFait = enrollment and faites == module.lessons|length and faites > 0 %}
        {# Un cours terminé reste fermé : on l'ouvre d'un clic. #}
        <details class="cb-cours"{{ coursFait ? '' : ' open' }}>
            {% if module.coverImage %}
                <img class="cb-cours-image" src="{{ '/uploads/modules/' ~ module.coverImage }}" alt="" loading="lazy">
            {% endif %}
            <summary class="cb-cours-tete">
                <span class="cb-case-num{{ coursFait ? ' est-fait' }}">
                    {% if coursFait %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visuellement-cache">Cours terminé : </span>{% else %}{{ module.displayOrder }}{% endif %}
                </span>
                <div class="cb-cours-titre">
                    <p class="cb-plan-sur">Cours {{ module.displayOrder }}</p>
                    <h3 class="cb-h3">{{ module.title }}</h3>
                    {% if module.description %}<div class="cb-cours-desc">{{ '<' in module.description ? module.description|raw : module.description|nl2br }}</div>{% endif %}
                </div>
                <span class="cb-discret cb-cours-compte">{% if enrollment %}{{ faites }}/{{ module.lessons|length }}{% else %}{{ module.lessons|length }}{% endif %} leçons <svg class="cb-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </summary>

            <ol class="cb-cours-lecons">
                {% for lesson in module.lessons %}
                    {% set fait = completedLessonIds[lesson.id] ?? false %}
                    <li class="cb-plan-item{{ fait ? ' est-fait' }}">
                        {% if enrollment %}
                            <a href="{{ path('app_lesson_show', { slug: formation.slug, moduleSlug: module.slug, lessonSlug: lesson.slug }) }}">
                        {% else %}
                            <div class="cb-cours-verrou">
                        {% endif %}
                            <span class="cb-plan-num">
                                {% if fait %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visuellement-cache">Terminée : </span>{% else %}{{ loop.index }}{% endif %}
                            </span>
                            <span class="cb-plan-texte">
                                <strong>{{ lesson.title }}</strong>
                                <em>{{ m.duree(lesson.durationSeconds) }}</em>
                            </span>
                            {% if enrollment %}
                                <span class="cb-cours-action">{{ fait ? 'Revoir' : 'Ouvrir' }} →</span>
                            {% else %}
                                <svg class="cb-cours-cadenas" viewBox="0 0 24 24" aria-label="Réservée aux inscriptions"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                            {% endif %}
                        {% if enrollment %}</a>{% else %}</div>{% endif %}
                    </li>
                {% endfor %}
            </ol>
        </details>
    {% endfor %}
</section>

{% endblock %}
