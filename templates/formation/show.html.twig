{% extends '_mon_cartable.html.twig' %}
{% import '_partials/_macros.html.twig' as m %}

{% set active_nav = enrollment ? 'dashboard' : 'catalogue' %}

{% block title %}{{ formation.title }} · La Récrée Tech{% endblock %}

{% block contenu %}
{% set coche %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set nbEtapes = programme.etapes|length %}

<nav class="cb-fil" aria-label="Fil d'Ariane">
    {% if enrollment %}<a href="{{ path('app_dashboard') }}">Mon cartable</a>{% else %}<a href="{{ path('app_catalogue') }}">Les formations</a>{% endif %}
    <span aria-hidden="true">›</span>
    <span>{{ formation.title }}</span>
</nav>

{# En haut, sur le tableau vert : où l'élève en est, et la leçon à reprendre. #}
{% if enrollment %}
    {% set pct = programme.pourcent %}
    <section class="cb-prog-tete">
        <svg class="cb-anneau" viewBox="0 0 92 92" role="img" aria-label="{{ pct }} % de la formation">
            <circle class="cb-anneau-fond" cx="46" cy="46" r="38"/>
            <circle class="cb-anneau-plein" cx="46" cy="46" r="38" stroke-dasharray="{{ (238.76 * pct / 100)|round(1) }} 238.76" transform="rotate(-90 46 46)"/>
            <text x="46" y="53" text-anchor="middle">{{ pct }} %</text>
        </svg>
        <div class="cb-prog-texte">
            <p class="cb-num">{{ formation.title }}</p>
            {% if programme.reprise %}
                {% set ici = programme.etapes[programme.ouverte] %}
                <h1 class="cb-prog-titre">Étape {{ ici.numero }} sur {{ nbEtapes }} : <em>{{ ici.nom }}</em></h1>
            {% else %}
                <h1 class="cb-prog-titre">Les {{ nbEtapes }} étapes sont <em>faites</em>.</h1>
            {% endif %}
            <p class="cb-prog-meta"><strong>{{ programme.faites }} leçon{{ programme.faites > 1 ? 's' }} sur {{ programme.lecons }}</strong>{% if programme.resteSecondes > 0 %} · encore {{ m.heures(programme.resteSecondes) }} de vidéo{% endif %}</p>
        </div>
        {% if programme.reprise %}
            {% set lecon = programme.reprise %}
            <a href="{{ path('app_lesson_show', { slug: formation.slug, moduleSlug: lecon.module.slug, lessonSlug: lecon.slug }) }}" class="ct-bouton cb-bouton cb-prog-bouton">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
                <span>{{ programme.reprisePourcent > 0 ? 'Reprendre' : (programme.faites > 0 ? 'Continuer avec' : 'Commencer') }} « {{ lecon.title }} »</span>
            </a>
        {% endif %}
    </section>
{% else %}
    <section class="cb-prog-tete cb-prog-tete-vente">
        <div class="cb-prog-texte">
            <p class="cb-num">La formation</p>
            <h1 class="cb-prog-titre">{{ formation.title }}</h1>
            {% if formation.subtitle %}<p class="cb-prog-note">{{ formation.subtitle }}</p>{% endif %}
            <p class="cb-prog-meta">{{ nbEtapes }} étapes · {{ programme.lecons }} leçons · {{ m.heures(programme.secondes) }} de vidéo</p>
        </div>
        <div class="cb-prog-achat">
            <p class="cb-cahier-prix">{{ m.prix(formation) }}</p>
            <a href="{{ path('app_checkout_start', { slug: formation.slug }) }}" class="ct-bouton">Je prends ma place</a>
            <a href="{{ path('app_checkout_start', { slug: formation.slug, plan: '3x' }) }}" class="cb-lien">ou en 3 fois sans frais</a>
        </div>
    </section>
    {% if formation.description %}
        <div class="cb-formation-desc">{{ '<' in formation.description ? formation.description|raw : formation.description|nl2br }}</div>
    {% endif %}
{% endif %}

{# Les étapes en onglets : une à la fois, celle en cours ouverte d'office. #}
<section class="cb-etapes" data-controller="onglets" aria-label="Le programme">
    <div class="cb-onglets" role="tablist" aria-label="Les étapes">
        {% for etape in programme.etapes %}
            {% set choisi = loop.index0 == programme.ouverte %}
            <button type="button" role="tab" id="onglet-{{ etape.numero }}" aria-controls="etape-{{ etape.numero }}" aria-selected="{{ choisi ? 'true' : 'false' }}" tabindex="{{ choisi ? 0 : -1 }}"
                    class="cb-onglet est-{{ etape.statut }}" data-onglets-target="onglet" data-action="onglets#montrer keydown->onglets#clavier">
                <span class="cb-onglet-haut">
                    <span class="cb-onglet-num">{% if etape.statut == 'fait' %}{{ coche }}<span class="visuellement-cache">Étape {{ etape.numero }} terminée : </span>{% else %}{{ etape.numero }}{% endif %}</span>
                    <span class="cb-onglet-nom">{{ etape.nom }}</span>
                </span>
                {% if enrollment %}
                    <span class="cb-progres cb-progres-clair" aria-hidden="true"><span style="width: {{ etape.pourcent }}%"></span></span>
                    <span class="cb-onglet-compte">{{ etape.faites }}/{{ etape.lecons|length }} leçons</span>
                {% else %}
                    <span class="cb-onglet-compte">{{ etape.lecons|length }} leçons · {{ m.heures(etape.secondes) }}</span>
                {% endif %}
            </button>
        {% endfor %}
    </div>

    {% for etape in programme.etapes %}
        <div class="cb-panneau" role="tabpanel" id="etape-{{ etape.numero }}" aria-labelledby="onglet-{{ etape.numero }}" tabindex="0" data-onglets-target="panneau"{{ loop.index0 == programme.ouverte ? '' : ' hidden' }}>
            <div class="cb-panneau-texte">
                <p class="cb-num">Étape {{ etape.numero }}{% if enrollment %} · {{ { fait: 'terminée', encours: 'en cours', avenir: 'à venir' }[etape.statut] }}{% endif %}</p>
                <h2 class="cb-panneau-nom">{{ etape.nom }}</h2>
                {% if etape.promesse %}<p>{{ etape.promesse }}</p>{% endif %}
                {% if etape.texte %}<div class="cb-cours-desc">{{ etape.texte|raw }}</div>{% endif %}
                <p class="cb-discret">{% if enrollment %}<strong>{{ etape.faites }}/{{ etape.lecons|length }} leçons</strong>{% else %}{{ etape.lecons|length }} leçons{% endif %} · {{ m.heures(etape.secondes) }}</p>
                {% if etape.repars %}<p class="cb-repars"><b>Tu repars avec</b> {{ etape.repars }}</p>{% endif %}
            </div>

            <ol class="cb-cours-lecons">
                {% for l in etape.lecons %}
                    {% set lesson = l.lesson %}
                    <li class="cb-plan-item{{ l.etat == 'fait' ? ' est-fait' }}{{ l.etat == 'ici' ? ' est-ici' }}">
                        {% if enrollment %}
                            <a href="{{ path('app_lesson_show', { slug: formation.slug, moduleSlug: lesson.module.slug, lessonSlug: lesson.slug }) }}"{{ l.etat == 'ici' ? ' aria-current="step"' }}>
                        {% else %}
                            <div class="cb-cours-verrou">
                        {% endif %}
                            <span class="cb-plan-num">
                                {% if l.etat == 'fait' %}{{ coche }}<span class="visuellement-cache">Terminée : </span>{% else %}{{ loop.index }}{% endif %}
                            </span>
                            <span class="cb-plan-texte">
                                <strong>{{ lesson.title }}</strong>
                                <em>{{ m.duree(lesson.durationSeconds) }}{% if l.etat == 'ici' and l.pourcent > 0 %} · {{ l.pourcent }} % vus{% endif %}</em>
                                {% if l.etat == 'ici' %}
                                    {% if l.pourcent > 0 %}<span class="cb-progres cb-progres-lecon" aria-hidden="true"><span style="width: {{ l.pourcent }}%"></span></span>{% endif %}
                                    {% if l.atoi %}<span class="cb-atoi"><b>À toi :</b> {{ l.atoi }}</span>{% endif %}
                                {% endif %}
                            </span>
                            {% if enrollment %}
                                <span class="cb-cours-action">{{ l.etat == 'fait' ? 'Revoir' : (l.etat == 'ici' and l.pourcent > 0 ? 'Reprendre' : 'Ouvrir') }} →</span>
                            {% else %}
                                <svg class="cb-cours-cadenas" viewBox="0 0 24 24" aria-label="Réservée aux inscriptions"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                            {% endif %}
                        {% if enrollment %}</a>{% else %}</div>{% endif %}
                    </li>
                {% endfor %}
            </ol>
        </div>
    {% endfor %}
</section>

{% endblock %}
