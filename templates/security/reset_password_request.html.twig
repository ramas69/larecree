{% extends 'security/_cartable.html.twig' %}

{% block title %}Mot de passe oublié · La Récrée Tech{% endblock %}
{% block retour %}<a href="{{ path('app_login') }}" class="ct-retour">← Retour à la connexion</a>{% endblock %}
{% block tableau %}Pas grave, ça <em>arrive</em>.{% endblock %}
{% block note %}même au premier rang{% endblock %}

{% block carte %}
    <p class="ct-eyebrow">Mot de passe oublié</p>
    {% if sent %}
        <h1 class="ct-titre">Regarde ta <em>boîte mail</em>.</h1>
        <p class="ct-sous">Si un compte existe avec cette adresse, un e-mail avec un lien vient de partir. Regarde aussi dans les indésirables. Le lien est valable 60 minutes.</p>
        <a href="{{ path('app_login') }}" class="ct-bouton">Retour à la connexion</a>
    {% else %}
        <h1 class="ct-titre">On t'envoie un <em>lien</em>.</h1>
        <p class="ct-sous">Indique l'e-mail de ton compte&nbsp;: tu recevras un lien pour choisir un nouveau mot de passe.</p>

        <form method="post" novalidate data-turbo="false">
            <div class="ct-champ">
                <label for="inputEmail">E-mail du compte</label>
                <input type="email" id="inputEmail" name="email" required autofocus autocomplete="email" placeholder="toi@exemple.com">
            </div>

            <input type="hidden" name="_token" value="{{ csrf_token('reset_request') }}">

            <button type="submit" class="ct-bouton">Envoyer le lien</button>
        </form>
    {% endif %}
{% endblock %}
