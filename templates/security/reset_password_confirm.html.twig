{% extends 'security/_cartable.html.twig' %}

{% block title %}Nouveau mot de passe · La Récrée Tech{% endblock %}
{% block retour %}<a href="{{ path('app_login') }}" class="ct-retour">← Retour à la connexion</a>{% endblock %}
{% block tableau %}Une nouvelle <em>clé</em>.{% endblock %}
{% block note %}et ton cartable se rouvre{% endblock %}

{% block carte %}
    <p class="ct-eyebrow">Nouveau mot de passe</p>
    <h1 class="ct-titre">Choisis ton <em>nouveau</em> mot de passe.</h1>
    <p class="ct-sous">Pour <strong>{{ user.email }}</strong>. 8 caractères minimum.</p>

    {% for error in errors %}
        <div class="ct-alerte" role="alert">{{ error }}</div>
    {% endfor %}

    <form method="post" novalidate data-turbo="false">
        <div class="ct-champ">
            <label for="inputPassword">Nouveau mot de passe</label>
            <input type="password" id="inputPassword" name="password" required autocomplete="new-password" minlength="8" autofocus>
        </div>

        <div class="ct-champ">
            <label for="inputPasswordConfirm">Encore une fois, pour vérifier</label>
            <input type="password" id="inputPasswordConfirm" name="password_confirm" required autocomplete="new-password" minlength="8">
        </div>

        <input type="hidden" name="_token" value="{{ csrf_token('reset_confirm_' ~ token) }}">

        <button type="submit" class="ct-bouton">Enregistrer</button>
    </form>
{% endblock %}
