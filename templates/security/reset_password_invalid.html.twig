{% extends 'security/_cartable.html.twig' %}

{% block title %}Lien expiré · La Récrée Tech{% endblock %}
{% block retour %}<a href="{{ path('app_login') }}" class="ct-retour">← Retour à la connexion</a>{% endblock %}
{% block tableau %}Le lien a <em>sonné</em>.{% endblock %}
{% block note %}on t'en envoie un autre{% endblock %}

{% block carte %}
    <p class="ct-eyebrow">Lien expiré</p>
    <h1 class="ct-titre">Ce lien n'est <em>plus valide</em>.</h1>
    <p class="ct-sous">Il a sans doute expiré (il dure 60 minutes) ou il a déjà servi. Demande-en un nouveau.</p>
    <a href="{{ path('app_reset_password_request') }}" class="ct-bouton">Demander un nouveau lien</a>
{% endblock %}
