{% extends 'base.html.twig' %}

{# Les pages de connexion et de mot de passe, dans le design « école » du site (refonte de novembre 2026). #}

{% block theme_color %}#1F3025{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=Lexend:wght@300;400;500&family=Caveat:wght@500;600&display=swap">
    <link rel="stylesheet" href="{{ asset('styles/cartable.css') }}">
{% endblock %}

{% block body %}
<div class="cartable">

    <header class="ct-entete">
        <a href="https://larecreetech.com" class="ct-marque" aria-label="La Récrée Tech, le site">
            <svg viewBox="0 0 280 280" aria-hidden="true"><g transform="translate(20 20)"><path d="M120 0A100 100 0 0 1 207 50L190 60A80 80 0 0 0 120 20Z" fill="currentColor"/><path d="M207 50A100 100 0 0 1 207 150L190 140A80 80 0 0 0 190 60Z" fill="currentColor"/><path d="M207 150A100 100 0 0 1 120 200L120 180A80 80 0 0 0 190 140Z" fill="currentColor"/><path d="M120 200A100 100 0 0 1 33 150L50 140A80 80 0 0 0 120 180Z" fill="currentColor"/><path d="M33 150A100 100 0 0 1 33 50L50 60A80 80 0 0 0 50 140Z" fill="none" stroke="currentColor" stroke-width="6" opacity=".45"/><path d="M33 50A100 100 0 0 1 120 0L120 20A80 80 0 0 0 50 60Z" fill="none" stroke="currentColor" stroke-width="6" opacity=".45"/><text x="120" y="138" font-family="Newsreader, Georgia, serif" font-size="92" font-style="italic" fill="currentColor" text-anchor="middle">r</text></g></svg>
            <span>la <em>récrée</em> tech.</span>
        </a>
        {% block retour %}<a href="https://larecreetech.com" class="ct-retour">← Retour au site</a>{% endblock %}
    </header>

    <main class="ct-main">
        <section class="ct-tableau" aria-hidden="true">
            <p class="ct-num">Mon cartable</p>
            <p class="ct-grand">{% block tableau %}La classe <em>t'attend</em>.{% endblock %}</p>
            <p class="ct-note">{% block note %}tes cours et tes devoirs sont là{% endblock %}</p>
          <svg class="ct-dessin" viewBox="0 0 260 220" aria-hidden="true">
            <rect x="62" y="22" width="136" height="44" rx="22" fill="none" stroke="#f3f1ea" stroke-width="10"/>
            <rect x="30" y="52" width="200" height="150" rx="20" fill="#efe6d3" stroke="#f3f1ea" stroke-width="3"/>
            <path d="M30 72 Q30 52 50 52 H210 Q230 52 230 72 V118 H30 Z" fill="#2e4637" stroke="#f3f1ea" stroke-width="3"/>
            <rect x="112" y="104" width="36" height="34" rx="6" fill="#e3ab1f" stroke="#1f3025" stroke-width="3"/>
            <rect x="124" y="114" width="12" height="12" rx="2" fill="#1f3025"/>
            <path d="M62 160 H120 M62 176 H104" stroke="#2e4637" stroke-width="5" stroke-linecap="round"/>
          </svg>
        </section>

        <section class="ct-feuille">
            <div class="ct-carte">
                {% block carte %}{% endblock %}
            </div>
        </section>
    </main>

    <footer class="ct-pied">
        <span>La récré, c'est l'école sans la peur.</span>
        <span>hello@larecreetech.com</span>
    </footer>

</div>
{% endblock %}
