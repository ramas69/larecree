{% extends 'base.html.twig' %}

{# Les pages de connexion et de mot de passe, dans le design « école » du site (refonte de novembre 2026). #}

{% block body %}
<div class="cartable">

    <header class="ct-entete">
        <a href="https://larecreetech.com" class="ct-marque" aria-label="La Récrée Tech, le site">
            {% include '_partials/_logo.html.twig' %}
            <span>la <em>récrée</em> tech.</span>
        </a>
        {% block retour %}<a href="https://larecreetech.com" class="ct-retour">← Retour au site</a>{% endblock %}
    </header>

    <main class="ct-main">
        <section class="ct-tableau" aria-hidden="true">
            <p class="ct-num">Mon cartable</p>
            <p class="ct-grand">{% block tableau %}La classe <em>t'attend</em>.{% endblock %}</p>
            <p class="ct-note">{% block note %}tes cours et tes devoirs sont là{% endblock %}</p>
          <svg class="ct-dessin" viewBox="0 0 260 220" aria-hidden="true">
            <rect x="62" y="22" width="136" height="44" rx="22" fill="none" stroke="#f3f1ea" stroke-width="10"/>
            <rect x="30" y="52" width="200" height="150" rx="20" fill="#efe6d3" stroke="#f3f1ea" stroke-width="3"/>
            <path d="M30 72 Q30 52 50 52 H210 Q230 52 230 72 V118 H30 Z" fill="#2e4637" stroke="#f3f1ea" stroke-width="3"/>
            <rect x="112" y="104" width="36" height="34" rx="6" fill="#e3ab1f" stroke="#1f3025" stroke-width="3"/>
            <rect x="124" y="114" width="12" height="12" rx="2" fill="#1f3025"/>
            <path d="M62 160 H120 M62 176 H104" stroke="#2e4637" stroke-width="5" stroke-linecap="round"/>
          </svg>
        </section>

        <section class="ct-feuille">
            <div class="ct-carte">
                {% block carte %}{% endblock %}
            </div>
        </section>
    </main>

    <footer class="ct-pied">
        <span>La récré, c'est l'école sans la peur.</span>
        <span>hello@larecreetech.com</span>
    </footer>

</div>
{% endblock %}
